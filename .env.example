# Zkopíruj tenhle soubor jako `.env` a vyplň hodnoty.
# `.env` se do gitu nikdy nedostane (je v .gitignore).

# --- Databáze ---------------------------------------------------------
# Lokální vývoj (SQLite, nic víc není potřeba):
DATABASE_URL="file:./dev.db"
#
# Produkce na Vercelu (Postgres — např. Neon nebo Vercel Postgres).
# Nezapomeň v prisma/schema.prisma přepnout provider na "postgresql".
# DATABASE_URL="postgresql://uzivatel:heslo@host/databaze?sslmode=require"

# --- Přihlášení do administrace --------------------------------------
# Heslo majitelky, zahashované bcryptem a zakódované do base64.
# Vygeneruješ příkazem:
#   npm run admin:hash -- tvojeheslo
#
# Base64 podobu používáme schválně: bcrypt hash obsahuje znak `$`
# a Next.js by ho v .env souboru expandoval jako proměnnou.
ADMIN_PASSWORD_HASH=""

# Tajný klíč pro podepisování přihlašovací cookie (min. 16 znaků).
# Vygeneruj náhodný řetězec, např.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- E-maily (Resend) --------------------------------------------------
# Bez tohohle web funguje úplně stejně, jen se e-maily neposílají —
# poptávky se dál ukládají, jen o nich majitelka nedostane upozornění.
# Založení účtu a získání klíče: https://resend.com (má štědrý free tier).
# Podrobný postup je v README.md.
RESEND_API_KEY=""

# Odesílací adresa. Bez vlastní ověřené domény funguje sandbox adresa
# Resendu beze změny — jen si e-maily nemůžeš poslat sám sobě, jen na
# jiné adresy. Až si v Resendu ověříš vlastní doménu, přepni na
# "Eliščin dvůr <rezervace@eliscindvur.cz>".
EMAIL_FROM="Eliščin dvůr <onboarding@resend.dev>"
